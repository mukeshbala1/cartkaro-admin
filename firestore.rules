rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.superAdmin == true ||
        request.auth.token.customerSupport == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.superAdmin == true ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superAdmin')
      );
    }

    function isPartnerOwner() {
      return request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Delivery rider profiles
    match /partners/{partnerId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == partnerId);
      allow create: if request.auth != null && request.auth.uid == partnerId;
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == partnerId);
      allow delete: if isAdmin();
    }

    // Business partner registration drafts — written by the partner app,
    // read and updated (verification decisions) by admins.
    match /registration_drafts/{draftId} {
      allow read: if isAdmin() || request.auth != null;
      allow create: if request.auth != null;
      allow update: if isAdmin() || request.auth != null;
      allow delete: if isAdmin();

      // Admin activity log subcollection
      match /adminActivity/{noteId} {
        allow read, write: if isAdmin();
      }
    }

    match /partnerUpdateRequests/{requestId} {
      allow read: if isAdmin() || isPartnerOwner();
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Admin role records — manageable by Super Admins
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
